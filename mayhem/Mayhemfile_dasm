# Mayhem target `dasm` — the DASM macro assembler CLI.
#
# File-input target (`dasm <file>`): a plain sanitized (ASan+UBSan) build with NO compile-time
# AFL/SanCov instrumentation — Mayhem's own engine instruments/executes the ELF directly (see
# mayhem/build.sh for why compile-time instrumentation regressed coverage to 0 edges). Each input is
# assembled in a fresh forked process, so DASM's heavy global state resets every run. The original
# target slug `dasm` is preserved.
project: savantenvs/dasm
target: dasm

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/dasm/testsuite

cmds:
  # -o writes the assembled output to /tmp (writable) rather than a.out in the CWD, so the target never
  # depends on a writable working dir under the read-only image mount. @@ is the input assembly file.
  - cmd: /mayhem/dasm @@ -o/tmp/dasm.out
